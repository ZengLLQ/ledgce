# Copy to .env (or run scripts/setup-env.ps1 / scripts/setup-env.sh to generate random tokens).
# .env is git-ignored. Never commit real secrets.

# Environment guard. Simulation and worker-control endpoints are refused unless this is "local".
LEDGCE_ENV=local

# PostgreSQL (docker-compose service, loopback only)
LEDGCE_PG_USER=ledgce
LEDGCE_PG_PASSWORD=change_me_local_only
LEDGCE_PG_DB=ledgce
LEDGCE_PG_PORT=5433
DATABASE_URL=postgres://ledgce:change_me_local_only@127.0.0.1:5433/ledgce

# API
LEDGCE_API_BIND=127.0.0.1:8080
LEDGCE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LEDGCE_RATE_LIMIT_PER_MINUTE=600

# Bearer tokens (generated randomly by the setup script; two roles).
LEDGCE_ADMIN_TOKEN=
LEDGCE_READER_TOKEN=

# Worker
LEDGCE_WORKER_ID=
LEDGCE_OUTBOX_MAX_ATTEMPTS=6
LEDGCE_OUTBOX_LEASE_SECONDS=30

# Frontend dev proxy injects LEDGCE_ADMIN_TOKEN server-side (never shipped to the browser).
